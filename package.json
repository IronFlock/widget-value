{
    "name": "@ironflock/widget-value",
    "description": "REWidget widget-value",
    "license": "MIT",
    "author": "widget-value",
    "version": "1.1.33",
    "engines": {
        "node": ">=24.9.0",
        "npm": ">=10.0.2"
    },
    "type": "module",
    "main": "dist/widget-value.js",
    "types": "dist/src/widget-value.d.ts",
    "files": [
        "dist",
        "src",
        "thumbnail.png",
        "thumbnail.webp"
    ],
    "scripts": {
        "analyze": "cem analyze --litelement",
        "start": "vite build --watch & vite",
        "build": "vite build",
        "watch": "vite build --watch",
        "link": "npm run build && npm link && cd ../RESWARM/frontend && npm link @ironflock/widget-value",
        "unlink": "npm unlink --global && cd ../RESWARM/frontend && npm unlink @ironflock/widget-value && npm i @ironflock/widget-value",
        "types": "cat src/definition-schema.json | json2ts --style.tabWidth=4 > src/definition-schema.d.ts",
        "preversion": "sh scripts/release-preflight.sh",
        "version": "npm run build",
        "postversion": "git push --follow-tags && sh scripts/release-verify.sh",
        "release": "npm version patch",
        "release:minor": "npm version minor",
        "release:major": "npm version major"
    },
    "dependencies": {
        "lit": "^3.3.3",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@custom-elements-manifest/analyzer": "^0.10.4",
        "@rollup/plugin-replace": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.34.1",
        "@typescript-eslint/parser": "^8.34.1",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "husky": "^9.1.7",
        "json-schema-to-typescript": "^15.0.4",
        "lint-staged": "^16.1.2",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "typescript": "^5.8.3",
        "vite": "^7.3.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IronFlock/widget-value.git"
    },
    "keywords": [
        "widget",
        "value"
    ],
    "bugs": {
        "url": "https://github.com/IronFlock/widget-value/issues"
    },
    "homepage": "https://github.com/IronFlock/widget-value#readme"
}
